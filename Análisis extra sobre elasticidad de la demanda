    {
      "cell_type": "code",
      "source": [
        "df_f = df.copy()\n",
        "df_f['CANTID'] = pd.to_numeric(\n",
        "    df_f['CANTID'].str.replace(',', '.'), errors='coerce'\n",
        ")\n",
        "df_f['PUBLICO VENTA'] = pd.to_numeric(\n",
        "    df_f['PUBLICO VENTA'].str.replace(',', '.'), errors='coerce'\n",
        ")\n",
        "df_f['FECHA'] = pd.to_datetime(\n",
        "    df_f['FECHA'], format='%d/%m/%Y', errors='coerce'\n",
        ")\n",
        "\n",
        "df_f = df_f.dropna(subset=['DESCRIPX', 'FECHA', 'CANTID', 'PUBLICO VENTA'])\n",
        "\n",
        "palabras_excluidas = [\n",
        "    'PAÑALES','TOALLITAS', 'JABON','TALCO', 'CREMA','COSMETICA', 'PROTECTOR', 'AGUJAS', 'JERINGAS','PRESERV','PASTA','COLONIA','PERFUME','TINTURA', 'EMULSION', \"CREMA HIDRATANTE\", \"SERUM FACIAL\", \"PROTECTOR SOLAR\", \"AGUA MICELAR\",\n",
        "    \"TONICO FACIAL\", \"GEL DE LIMPIEZA FACIAL\", \"BALSAMO LABIAL\", \"MASCARILLA FACIAL\",\"EMULSION HIDRATANTE\", \"CREMA ANTIARRUGAS\", \"EXFOLIANTE FACIAL\", \"LECHE DE LIMPIEZA\",\n",
        "    \"CREMA CORPORAL\", \"GEL DE DUCHA\", \"JABON LIQUIDO\", \"JABON DE TOCADOR\", \"ACEITE CORPORAL\", \"CREMA DE MANOS\", \"CREMA DE PIES\", \"TALCO PARA PIES\",\"DESODORANTE\", \"ANTITRANSPIRANTE\", \"CREMA REDUCTORA\",\n",
        "    \"SHAMPOO\", \"ACONDICIONADOR\", \"MASCARA CAPILAR\", \"TINTURA PARA EL CABELLO\", \"AMPOLLA CAPILAR\", \"SERUM CAPILAR\", \"CREMA PARA PEINAR\", \"GEL CAPILAR\",  \"ESPUMA DE AFEITAR\", \"MAQUINITA DE AFEITAR\", \"BANDAS DE CERA DEPILATORIA\",\n",
        "    \"CREMA DEPILATORIA\", \"GEL PARA DESPUES DE AFEITAR\",\"PASTA DE DIENTES\", \"CEPILLO DE DIENTES\", \"ENJUAGUE BUCAL\", \"HILO DENTAL\"\n",
        "]\n",
        "\n",
        "\n",
        "def es_medicamento(texto):\n",
        "  if not isinstance(texto, str):\n",
        "    return False\n",
        "  t = texto.upper()\n",
        "  for ex in palabras_excluidas:\n",
        "    if re.search(r'\\b' + re.escape(ex) + r'\\b', t):\n",
        "      return False\n",
        "  return True\n",
        "\n",
        "\n",
        "df_f = df_f[df_f['DESCRIPX'].apply(es_medicamento)]\n",
        "\n",
        "def extraer_nombre_base(texto):\n",
        "  t = texto.upper()\n",
        "  t = re.sub(r'\\b\\d+[\\.,]?\\d*\\s*(MG|G|GR|ML|CC|UI|%)\\b', '', t)\n",
        "  t = re.sub(\n",
        "      r'\\b(COMP|CÁPS|CAPS|TAB|SUSP|SOL|GEL|JARABE|GOTAS|AMP|OVULOS|SPRAY|INHAL|F|FORTE|REC|MAST|LIB|PROL)\\b',\n",
        "      '',\n",
        "      t,\n",
        "  )\n",
        "  t = re.sub(r'\\bx\\s*\\d+\\b', '', t)\n",
        "  t = re.sub(r'[\\.\\,\\-\\/\\(\\)]', ' ', t)\n",
        "  t = re.sub(r'\\s+', ' ', t).strip()\n",
        "\n",
        "  palabras = t.split()\n",
        "  if len(palabras) >= 2:\n",
        "    return f'{palabras[0]} {palabras[1]}'\n",
        "  elif len(palabras) == 1:\n",
        "    return palabras[0]\n",
        "  return ''\n",
        "\n",
        "\n",
        "df_f['DESCRIP_BASE'] = df_f['DESCRIPX'].apply(extraer_nombre_base)\n",
        "df_f = df_f[df_f['DESCRIP_BASE'] != '']\n",
        "\n",
        "df_f['Mes'] = df_f['FECHA'].dt.to_period('M')\n",
        "\n",
        "mensual = (\n",
        "    df_f.groupby(['DESCRIP_BASE', 'Mes'])\n",
        "    .agg({'CANTID': 'sum', 'PUBLICO VENTA': 'mean'})\n",
        "    .reset_index()\n",
        "    .sort_values(['DESCRIP_BASE', 'Mes'])\n",
        ")\n",
        "\n",
        "inicio_mes = pd.Period('2025-09', freq='M')\n",
        "final_mes = pd.Period('2026-09', freq='M')\n",
        "\n",
        "df_inicio = mensual[mensual['Mes'] == inicio_mes].rename(\n",
        "    columns={\n",
        "        'CANTID': 'Q_inicio',\n",
        "        'PUBLICO VENTA': 'P_inicio',\n",
        "        'Mes': 'Mes_inicio',\n",
        "    }\n",
        ")\n",
        "df_final = mensual[mensual['Mes'] == final_mes].rename(\n",
        "    columns={'CANTID': 'Q_final', 'PUBLICO VENTA': 'P_final', 'Mes': 'Mes_final'}\n",
        ")\n",
        "\n",
        "resultado = pd.merge(df_inicio, df_final, on='DESCRIP_BASE')\n",
        "resultado = resultado.dropna(\n",
        "    subset=['Q_inicio', 'Q_final', 'P_inicio', 'P_final']\n",
        ")\n",
        "\n",
        "Q1 = resultado['Q_inicio']\n",
        "Q2 = resultado['Q_final']\n",
        "P1 = resultado['P_inicio']\n",
        "P2 = resultado['P_final']\n",
        "\n",
        "delta_q = Q2 - Q1\n",
        "promedio_q = (Q1 + Q2) / 2.0\n",
        "\n",
        "delta_p = P2 - P1\n",
        "promedio_p = (P1 + P2) / 2.0\n",
        "\n",
        "resultado['elasticidad_arco'] = np.where(\n",
        "    (promedio_q != 0) & (promedio_p != 0) & (delta_p != 0),\n",
        "    abs((delta_q / promedio_q) / (delta_p / promedio_p)),\n",
        "    np.nan,\n",
        ")\n",
        "\n",
        "resultado.loc[(delta_q == 0) & (delta_p != 0), 'elasticidad_arco'] = 0.0\n",
        "resultado = resultado.replace([np.inf, -np.inf], np.nan).dropna(\n",
        "    subset=['elasticidad_arco']\n",
        ")\n",
        "\n",
        "def clasificar_punto_medio(e):\n",
        "  if np.isclose(e, 1.0, atol=1e-4):\n",
        "    return 'Elasticidad Unitaria (|E| = 1)'\n",
        "  elif e > 1.0:\n",
        "    return 'Demanda Elástica (|E| > 1)'\n",
